{
  "name": "n8n-nodes-bitbucket-repo-trigger",
  "version": "0.4.0",
  "description": "Bitbucket Cloud PR triggers and read-only PR context using a repository access token",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "bitbucket",
    "webhook",
    "pull-request"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepack": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BitbucketRepositoryToken.credentials.js"
    ],
    "nodes": [
      "dist/nodes/BitbucketRepositoryTrigger/BitbucketRepositoryTrigger.node.js",
      "dist/nodes/BitbucketRepositoryPoll/BitbucketRepositoryPoll.node.js",
      "dist/nodes/BitbucketRepository/BitbucketRepository.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": ">=2.16.0 <3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "n8n-workflow": "2.46.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
